# ─── Neon Postgres ────────────────────────────────────────────────────────────
# Get from: https://console.neon.tech → your project → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── GitHub App ───────────────────────────────────────────────────────────────
# Get from: GitHub → Settings → Developer settings → GitHub Apps → your app

# The numeric App ID shown on your GitHub App's General settings page
GITHUB_APP_ID=123456

# The private key downloaded from your GitHub App settings (PEM format).
# Replace actual newlines with \n so it fits on one line.
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"

# The secret you set in the Webhook section of your GitHub App settings.
# Used to verify that incoming webhook payloads are genuinely from GitHub.
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ─── Server ───────────────────────────────────────────────────────────────────
# Port the Fastify server listens on (Render/Railway override this automatically)
PORT=3000

# Log level: trace | debug | info | warn | error | fatal
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── Redis Queue (BullMQ) ──────────────────────────────────────────────────────
# Get from: https://console.upstash.com → Redis → your database → REST API
# Free tier: 10,000 commands/day — no credit card required
# Format: redis://default:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379

# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Dashboard ────────────────────────────────────────────────────────────────
# Public URL of your deployed server (used in PR comment footer link)
DASHBOARD_URL=https://ai-code-risk-monitor.onrender.com/dashboard

# GitHub OAuth App credentials (for Web Dashboard login)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
JWT_SECRET=your_jwt_secret_here
