# ─── Neon Postgres ────────────────────────────────────────────────────────────
# Get from: https://console.neon.tech → your project → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── GitHub App ───────────────────────────────────────────────────────────────
# Get from: GitHub → Settings → Developer settings → GitHub Apps → your app

# The numeric App ID shown on your GitHub App's General settings page
GITHUB_APP_ID=123456

# The private key downloaded from your GitHub App settings (PEM format).
# Replace actual newlines with \n so it fits on one line.
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"

# The secret you set in the Webhook section of your GitHub App settings.
# Used to verify that incoming webhook payloads are genuinely from GitHub.
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ─── Server ───────────────────────────────────────────────────────────────────
# Port the Fastify server listens on (Render/Railway override this automatically)
PORT=3000

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
